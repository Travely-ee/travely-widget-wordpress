#. Plugin Name of the plugin
#: travely-widget.php
msgid "Travely Widget"
msgstr "Travely logrīks"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: travely-widget.php
msgid "https://travely-solutions.eu"
msgstr "https://travely-solutions.eu"

#. Description of the plugin
#: travely-widget.php
msgid "The plugin allows you to use the Travely system widget on your website."
msgstr "Spraudnis ļauj izmantot Travely sistēmas logrīku jūsu tīmekļa vietnē."

#. Author of the plugin
#: travely-widget.php
msgid "Travely Solutions OÜ"
msgstr "Travely Solutions OÜ"

#: admin/class-travely-widget-admin.php:89
msgid "Travely Widget Settings"
msgstr "Travely logrīka iestatījumi"

#: admin/class-travely-widget-admin.php:90
msgid "Configure your Travely Widget public key, search results page path and language behavior."
msgstr "Konfigurējiet Travely Widget publisko atslēgu, meklēšanas rezultātu lapas ceļu un valodas darbību."

#: admin/class-travely-widget-admin.php:171
msgid "Default language"
msgstr "Noklusējuma valoda"

#: admin/class-travely-widget-admin.php:179
msgid "Force default language"
msgstr "Vienmēr izmantot noklusējuma valodu"

#: admin/class-travely-widget-admin.php:233
msgid "Used when language cannot be detected automatically."
msgstr "Tiek izmantota, ja valodu nevar noteikt automātiski."

#: admin/class-travely-widget-admin.php:248
msgid "Always use the selected default language."
msgstr "Vienmēr izmantot izvēlēto noklusējuma valodu."

#: admin/class-travely-widget-admin.php:253
msgid "When enabled, URL language, Polylang/WPML language and WordPress locale are ignored."
msgstr "Ja iespējots, URL valoda, Polylang/WPML valoda un WordPress lokāle tiek ignorēta."

#: includes/class-travely-widget-language.php:26
msgid "Estonian"
msgstr "Igauņu"

#: includes/class-travely-widget-language.php:27
msgid "English"
msgstr "Angļu"

#: includes/class-travely-widget-language.php:28
msgid "Russian"
msgstr "Krievu"

#: includes/class-travely-widget-language.php:29
msgid "Latvian"
msgstr "Latviešu"

#: admin/class-travely-widget-admin.php:137
msgid "API Key"
msgstr "API atslēga"

#: admin/class-travely-widget-admin.php:145
msgid "Path to Search"
msgstr "Meklēšanas ceļš"

#: admin/class-travely-widget-admin.php:153
msgid "Remove data on uninstall"
msgstr "Dzēst datus atinstalēšanas laikā"

#: admin/class-travely-widget-admin.php:186
msgid "Remove plugin settings when uninstalling the plugin."
msgstr "Dzēst spraudņa iestatījumus, atinstalējot spraudni."

#: includes/class-travely-widget-activator.php:41
msgid "Travely Widget requires WordPress 5.8 or higher."
msgstr "Travely logrīkam nepieciešams WordPress 5.8 vai jaunāka versija."

#: includes/class-travely-widget-updater.php:112
msgid "GitHub API request failed."
msgstr "GitHub API pieprasījums neizdevās."

#: includes/class-travely-widget-updater.php:118
msgid "Invalid GitHub API response."
msgstr "Nederīga GitHub API atbilde."

#: includes/class-travely-widget-updater.php:226
msgid "Update available from GitHub."
msgstr "Atjauninājums ir pieejams GitHub platformā."

#: includes/class-travely-widget-updater.php:279
msgid "View on GitHub"
msgstr "Skatīt GitHub"

#: blocks/results/block.json
msgctxt "block title"
msgid "Travely Results Widget"
msgstr "Travely rezultātu logrīks"

#: blocks/results/block.json
msgctxt "block description"
msgid "Displays the Travely search results widget."
msgstr "Parāda Travely meklēšanas rezultātu logrīku."

#: blocks/search/block.json
msgctxt "block title"
msgid "Travely Search Widget"
msgstr "Travely meklēšanas logrīks"

#: blocks/search/block.json
msgctxt "block description"
msgid "Displays the Travely search widget."
msgstr "Parāda Travely meklēšanas logrīku."

#: public/class-travely-widget-public.php:140
msgid "Travely Widget: multiple languages on one page are not supported. Requested \"%s\", using \"%s\"."
msgstr "Travely Widget: vairākas valodas vienā lapā netiek atbalstītas. Pieprasīts \"%s\", tiek izmantots \"%s\"."

#. Documentation warning
msgid "Do not mix different Travely Widget languages on the same page."
msgstr "Neizmantojiet dažādas Travely Widget valodas vienā lapā."

#. Documentation note
msgid "The language shortcode attribute overrides automatic language detection unless Force default language is enabled."
msgstr "Shortcode atribūts language pārraksta automātisko valodas noteikšanu, ja vien nav iespējota noklusējuma valodas piespiedu izmantošana."

#: admin/class-travely-widget-admin.php:205
msgid "Path mode"
msgstr "Ceļa režīms"

#: admin/class-travely-widget-admin.php:257
msgid "Single path for all languages"
msgstr "Viens ceļš visām valodām"

#: admin/class-travely-widget-admin.php:258
msgid "Separate path for each language"
msgstr "Atsevišķs ceļš katrai valodai"

#: admin/class-travely-widget-admin.php:197
msgid "Language-specific paths"
msgstr "Valodai specifiski ceļi"

#: admin/class-travely-widget-admin.php:276
msgid "Choose whether all widget languages use the same search results page path or each language has its own path."
msgstr "Izvēlieties, vai visas logrīka valodas izmanto vienu meklēšanas rezultātu lapas ceļu vai katrai valodai ir savs ceļš."

#: admin/class-travely-widget-admin.php:337
msgid "Used only when Path mode is set to Separate path for each language."
msgstr "Izmanto tikai tad, ja ceļa režīms ir iestatīts uz atsevišķu ceļu katrai valodai."

#: admin/class-travely-widget-admin.php:214
msgid "Estonian search path"
msgstr "Igauņu meklēšanas ceļš"

#: admin/class-travely-widget-admin.php:223
msgid "English search path"
msgstr "Angļu meklēšanas ceļš"

#: admin/class-travely-widget-admin.php:232
msgid "Russian search path"
msgstr "Krievu meklēšanas ceļš"

#: admin/class-travely-widget-admin.php:241
msgid "Latvian search path"
msgstr "Latviešu meklēšanas ceļš"

#: admin/class-travely-widget-admin.php
msgid "Used when Path mode is set to Single path for all languages. In language-specific mode it is kept as a fallback."
msgstr "Izmanto, ja ceļa režīms ir iestatīts uz vienu ceļu visām valodām. Valodai specifisku ceļu režīmā tas tiek saglabāts kā rezerves vērtība."

#: admin/class-travely-widget-admin.php
msgid "Used only when Path mode is set to Separate path for each language. Leave empty to fall back to the default search path."
msgstr "Izmanto tikai tad, ja ceļa režīms ir iestatīts uz atsevišķu ceļu katrai valodai. Atstājiet tukšu, lai izmantotu noklusējuma meklēšanas ceļu."

