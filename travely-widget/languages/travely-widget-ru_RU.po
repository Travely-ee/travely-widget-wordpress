#. Plugin Name of the plugin
#: travely-widget.php
msgid "Travely Widget"
msgstr "Виджет Travely"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: travely-widget.php
msgid "https://travely-solutions.eu"
msgstr "https://travely-solutions.eu"

#. Description of the plugin
#: travely-widget.php
msgid "The plugin allows you to use the Travely system widget on your website."
msgstr "Плагин позволяет использовать виджет системы Travely на вашем сайте."

#. Author of the plugin
#: travely-widget.php
msgid "Travely Solutions OÜ"
msgstr "Travely Solutions OÜ"

#: admin/class-travely-widget-admin.php:89
msgid "Travely Widget Settings"
msgstr "Настройки виджета Travely"

#: admin/class-travely-widget-admin.php:90
msgid ""
"Configure your Travely Widget public key and the page path where search "
"results should be displayed."
msgstr ""
"Укажите открытый ключ виджета Travely и путь к странице, где должны "
"отображаться результаты поиска."

#: admin/class-travely-widget-admin.php:137
msgid "API Key"
msgstr "API ключ"

#: admin/class-travely-widget-admin.php:145
msgid "Path to Search"
msgstr "Путь к поиску"

#: admin/class-travely-widget-admin.php:153
msgid "Remove data on uninstall"
msgstr "Удалить настройки при удалении плагина"

#: admin/class-travely-widget-admin.php:186
msgid "Remove plugin settings when uninstalling the plugin."
msgstr "При удалении плагина удалите его настройки."

#: includes/class-travely-widget-activator.php:41
msgid "Travely Widget requires WordPress 5.8 or higher."
msgstr ""
"Для работы виджета Travely Widget требуется WordPress версии 5.8 или выше."

#: includes/class-travely-widget-updater.php:112
msgid "GitHub API request failed."
msgstr "Не удался запрос на GitHub API."

#: includes/class-travely-widget-updater.php:118
msgid "Invalid GitHub API response."
msgstr "Неверный ответ GitHub API."

#: includes/class-travely-widget-updater.php:226
msgid "Update available from GitHub."
msgstr "Обновление доступно на GitHub."

#: includes/class-travely-widget-updater.php:279
msgid "View on GitHub"
msgstr "Посмотреть на GitHub"

#: blocks/results/block.json
msgctxt "block title"
msgid "Travely Results Widget"
msgstr "Виджет результатов Travely"

#: blocks/results/block.json
msgctxt "block description"
msgid "Displays the Travely search results widget."
msgstr "Отображает виджет результатов поиска Travely."

#: blocks/search/block.json
msgctxt "block title"
msgid "Travely Search Widget"
msgstr "Виджет поиска Travely"

#: blocks/search/block.json
msgctxt "block description"
msgid "Displays the Travely search widget."
msgstr "Отображает виджет поиска Travely."

